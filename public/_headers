# Next's opengraph-image convention emits the images WITHOUT a .png extension,
# so Cloudflare Pages serves them as application/octet-stream and social
# scrapers (Facebook, X, LinkedIn, iMessage) reject the card image. Force the
# correct type on the OG image routes (query strings are ignored when matching).
/opengraph-image
  Content-Type: image/png

/*/opengraph-image
  Content-Type: image/png
